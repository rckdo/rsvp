{
  "rules": {
    ".read": false,
    ".write": false,
    "weddingTracker": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "rsvp": {
      "replies": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['name','attending','at'])"
        }
      }
    },
    "game": {
      "codes": {
        ".write": "auth != null && root.child('game/host/REPLACE_WITH_HOST_KEY').val() === auth.uid",
        "$code": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val().matches(/^q([1-9]|10)$/)"
        },
        ".read": "auth != null && root.child('game/host/REPLACE_WITH_HOST_KEY').val() === auth.uid"
      },
      "answers": {
        "$q": {
          ".read": "auth != null && (root.child('game/host/REPLACE_WITH_HOST_KEY').val() === auth.uid || root.child('game/config/revealed').child($q === 'tiebreak' ? 'q10' : $q).val() === true)"
        },
        ".write": "auth != null && root.child('game/host/REPLACE_WITH_HOST_KEY').val() === auth.uid"
      },
      "config": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('game/host/REPLACE_WITH_HOST_KEY').val() === auth.uid"
      },
      "host": {
        "$key": {
          ".write": "auth != null && $key === 'REPLACE_WITH_HOST_KEY' && newData.val() === auth.uid"
        }
      },
      "players": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('game/host/REPLACE_WITH_HOST_KEY').val() === auth.uid && !newData.exists()",
        "$slug": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
          ".validate": "$slug.matches(/^[a-z]+(-[a-z]+)+$/) && newData.hasChildren(['uid','claimedAt'])",
          "uid": {
            ".validate": "newData.isString()"
          },
          "claimedAt": {
            ".validate": "newData.isNumber()"
          },
          "lastChange": {
            ".write": "auth != null && root.child('game/players').child($slug).child('uid').val() === auth.uid",
            ".validate": "newData.isNumber()"
          },
          "found": {
            "$q": {
              ".write": "auth != null && root.child('game/players').child($slug).child('uid').val() === auth.uid && (!root.child('game/config/lockAt').exists() || now < root.child('game/config/lockAt').val())",
              ".validate": "$q.matches(/^q([1-9]|10)$/) && newData.hasChildren(['code','at']) && root.child('game/codes').child(newData.child('code').val()).val() === $q"
            }
          },
          "answers": {
            "$q": {
              ".write": "auth != null && root.child('game/players').child($slug).child('uid').val() === auth.uid && (!root.child('game/config/lockAt').exists() || now < root.child('game/config/lockAt').val()) && (root.child('game/players').child($slug).child('found').child($q).exists() || root.child('game/config/releasedAt').exists())",
              ".validate": "$q.matches(/^q([1-9]|10)$/) && newData.hasChildren(['at']) && (!newData.hasChild('human') || newData.child('human').val().matches(/^[RL]$/)) && (!newData.hasChild('dog') || newData.child('dog').val().matches(/^[ET]$/))"
            }
          },
          "tiebreak": {
            ".write": "auth != null && root.child('game/players').child($slug).child('uid').val() === auth.uid && (!root.child('game/config/lockAt').exists() || now < root.child('game/config/lockAt').val())",
            ".validate": "newData.hasChildren(['day','month','at']) && newData.child('day').isNumber() && newData.child('day').val() >= 1 && newData.child('day').val() <= 31 && newData.child('month').isNumber() && newData.child('month').val() >= 1 && newData.child('month').val() <= 12"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
